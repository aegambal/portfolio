<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Aegambal — ECE Engineer Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet"/>
<style>
/* ─── VARIABLES ─────────────────────────────────────────── */
:root{
    --indigo:#6366f1;--indigo-d:#4338ca;--indigo-l:#a5b4fc;
    --pink:#ec4899;--pink-d:#be185d;--pink-l:#f9a8d4;
    --cyan:#22d3ee;--cyan-d:#0e7490;--cyan-l:#a5f3fc;
    --amber:#f59e0b;--amber-l:#fcd34d;
    --bg:#050714;--bg2:#0c0e20;--bg3:#111328;
    --card:#13162a;--card2:#191d36;
    --border:rgba(99,102,241,.18);
    --text:#e2e8f0;--muted:#94a3b8;--subtle:#475569;
    --grad1:linear-gradient(135deg,var(--indigo),var(--pink));
    --grad2:linear-gradient(135deg,var(--cyan),var(--indigo));
    --grad3:linear-gradient(135deg,var(--pink),var(--amber));
    --font-display:'Syne',sans-serif;
    --font-body:'DM Sans',sans-serif;
    --ease-out:cubic-bezier(.16,1,.3,1);
    --ease-spring:cubic-bezier(.34,1.56,.64,1);
}

/* ─── RESET ──────────────────────────────────────────────── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:16px}
body{
    background:var(--bg);color:var(--text);
    font-family:var(--font-body);line-height:1.6;
    overflow-x:hidden;cursor:none;
}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
button{cursor:none;font-family:var(--font-body)}

/* ─── SCROLLBAR ──────────────────────────────────────────── */
::-webkit-scrollbar{width:5px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--indigo);border-radius:99px}
::-webkit-scrollbar-thumb:hover{background:var(--pink)}

/* ─── NOISE OVERLAY ──────────────────────────────────────── */
body::before{
    content:'';position:fixed;inset:0;pointer-events:none;z-index:1000;
    opacity:.035;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size:200px;
}

/* ─── CURSOR ─────────────────────────────────────────────── */
#cursor{
    position:fixed;width:10px;height:10px;border-radius:50%;
    background:var(--cyan);mix-blend-mode:difference;
    pointer-events:none;z-index:9999;transform:translate(-50%,-50%);
    transition:transform .1s,width .3s var(--ease-spring),height .3s var(--ease-spring);
    box-shadow:0 0 12px var(--cyan),0 0 24px var(--cyan);
}
#cursor-ring{
    position:fixed;width:36px;height:36px;border-radius:50%;
    border:1.5px solid rgba(99,102,241,.6);
    pointer-events:none;z-index:9998;transform:translate(-50%,-50%);
    transition:transform .18s var(--ease-out),width .3s var(--ease-spring),height .3s var(--ease-spring),border-color .3s;
}
body.cursor-hover #cursor{width:18px;height:18px;background:var(--pink)}
body.cursor-hover #cursor-ring{width:54px;height:54px;border-color:var(--pink)}

/* ─── LOADING SCREEN ──────────────────────────────────────── */
#loader{
    position:fixed;inset:0;z-index:9990;
    background:var(--bg);display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:2rem;
    transition:opacity .7s var(--ease-out),visibility .7s;
}
#loader.hide{opacity:0;visibility:hidden;pointer-events:none}
.loader-initials{
    font-family:var(--font-display);font-size:5rem;font-weight:800;
    background:var(--grad1);-webkit-background-clip:text;background-clip:text;color:transparent;
    letter-spacing:-.02em;
    animation:pulse-glow 1.5s ease-in-out infinite alternate;
}
@keyframes pulse-glow{
    from{filter:drop-shadow(0 0 8px var(--indigo))}
    to{filter:drop-shadow(0 0 24px var(--pink))}
}
.loader-bar-wrap{width:200px;height:3px;background:var(--bg3);border-radius:99px;overflow:hidden}
.loader-bar{
    height:100%;width:0;border-radius:99px;
    background:var(--grad1);
    animation:load-fill 1.8s var(--ease-out) forwards;
}
@keyframes load-fill{to{width:100%}}
.loader-label{
    font-family:var(--font-display);font-size:.75rem;letter-spacing:.2em;
    text-transform:uppercase;color:var(--muted);
}

/* ─── PARTICLE CANVAS ─────────────────────────────────────── */
#canvas{position:fixed;inset:0;z-index:0;pointer-events:none}

/* ─── NAVBAR ──────────────────────────────────────────────── */
nav{
    position:fixed;top:0;left:0;right:0;z-index:800;
    height:64px;padding:0 clamp(1rem,5vw,3rem);
    display:flex;align-items:center;justify-content:space-between;
    background:rgba(5,7,20,.7);backdrop-filter:blur(20px) saturate(1.5);
    border-bottom:1px solid var(--border);
    transition:box-shadow .3s;
}
nav.scrolled{box-shadow:0 8px 32px rgba(0,0,0,.4)}
.nav-logo{
    font-family:var(--font-display);font-size:1.25rem;font-weight:800;
    background:var(--grad1);-webkit-background-clip:text;background-clip:text;color:transparent;
}
.nav-links{display:flex;gap:2rem;list-style:none}
.nav-links a{
    font-size:.85rem;font-weight:500;letter-spacing:.04em;
    text-transform:uppercase;color:var(--muted);
    position:relative;padding:.25rem 0;transition:color .3s;
}
.nav-links a::after{
    content:'';position:absolute;bottom:0;left:0;width:0;height:2px;
    background:var(--grad1);border-radius:99px;
    transition:width .35s var(--ease-out);
}
.nav-links a:hover{color:var(--text)}
.nav-links a:hover::after,.nav-links a.active::after{width:100%}
.nav-links a.active{color:var(--indigo-l)}
.nav-burger{display:none;flex-direction:column;gap:5px;background:none;border:none;padding:4px}
.nav-burger span{width:22px;height:2px;background:var(--text);border-radius:2px;transition:.3s}
.mobile-menu{
    display:none;position:fixed;top:64px;left:0;right:0;z-index:799;
    background:rgba(5,7,20,.95);backdrop-filter:blur(20px);
    padding:1.5rem;flex-direction:column;gap:1rem;
    border-bottom:1px solid var(--border);
}
.mobile-menu.open{display:flex}
.mobile-menu a{font-size:1rem;font-weight:500;color:var(--muted);padding:.5rem 0;border-bottom:1px solid var(--border);transition:color .3s}
.mobile-menu a:hover{color:var(--indigo-l)}

/* ─── SECTIONS ────────────────────────────────────────────── */
section{position:relative;z-index:2;padding:clamp(5rem,10vh,8rem) clamp(1rem,8vw,5rem)}
.section-label{
    display:inline-block;font-family:var(--font-display);
    font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;
    color:var(--cyan);border:1px solid rgba(34,211,238,.25);
    border-radius:99px;padding:.3rem 1rem;margin-bottom:1.5rem;
}
.section-title{
    font-family:var(--font-display);font-size:clamp(2rem,5vw,3.2rem);
    font-weight:800;line-height:1.1;margin-bottom:.5rem;
    letter-spacing:-.02em;
}
.section-sub{color:var(--muted);font-size:1rem;max-width:560px;margin-bottom:3rem;line-height:1.7}

/* ─── HERO ────────────────────────────────────────────────── */
#hero{
    min-height:100vh;display:flex;align-items:center;
    padding-top:100px;gap:3rem;
    flex-wrap:wrap;
}
.hero-left{flex:1;min-width:300px}
.hero-badge{
    display:inline-flex;align-items:center;gap:.5rem;
    background:rgba(99,102,241,.12);border:1px solid rgba(99,102,241,.3);
    border-radius:99px;padding:.35rem 1rem;margin-bottom:1.5rem;
    font-size:.8rem;color:var(--indigo-l);font-weight:500;
}
.hero-badge-dot{width:6px;height:6px;border-radius:50%;background:var(--cyan);animation:blink 1.4s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
.hero-name{
    font-family:var(--font-display);font-size:clamp(3rem,8vw,5.5rem);
    font-weight:800;line-height:1;letter-spacing:-.03em;
    margin-bottom:1rem;
}
.shimmer-text{
    background:linear-gradient(90deg,var(--indigo-l) 0%,var(--pink-l) 30%,var(--cyan-l) 60%,var(--amber-l) 80%,var(--indigo-l) 100%);
    background-size:200% auto;
    -webkit-background-clip:text;background-clip:text;color:transparent;
    animation:shimmer 4s linear infinite;
}
@keyframes shimmer{to{background-position:200% center}}
.hero-subtitle{
    font-size:clamp(1rem,2.5vw,1.25rem);color:var(--muted);
    margin-bottom:2rem;line-height:1.7;max-width:500px;
}
.hero-subtitle em{color:var(--cyan);font-style:normal;font-weight:500}
.hero-ctas{display:flex;gap:1rem;flex-wrap:wrap}
.btn{
    display:inline-flex;align-items:center;gap:.5rem;
    padding:.75rem 1.75rem;border-radius:12px;
    font-family:var(--font-display);font-size:.9rem;font-weight:600;
    letter-spacing:.02em;border:none;transition:all .3s var(--ease-spring);
    position:relative;overflow:hidden;
}
.btn::before{
    content:'';position:absolute;inset:0;background:white;opacity:0;
    transition:opacity .2s;
}
.btn:hover::before{opacity:.07}
.btn-primary{background:var(--grad1);color:#fff;box-shadow:0 8px 24px rgba(99,102,241,.35)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(99,102,241,.5)}
.btn-outline{background:transparent;color:var(--text);border:1px solid var(--border)}
.btn-outline:hover{border-color:var(--indigo);color:var(--indigo-l);transform:translateY(-2px)}

/* ─── 3D HERO CARD ────────────────────────────────────────── */
.hero-right{flex:0 0 auto;perspective:800px}
.hero-card{
    width:clamp(260px,30vw,320px);
    background:var(--card);
    border:1px solid var(--border);
    border-radius:24px;padding:2rem;
    transform:rotateY(-12deg) rotateX(6deg) translateZ(0);
    transform-style:preserve-3d;
    box-shadow:
        0 30px 80px rgba(0,0,0,.5),
        0 0 0 1px rgba(99,102,241,.1),
        inset 0 1px 0 rgba(255,255,255,.05);
    animation:float3d 6s ease-in-out infinite;
    transition:transform .5s var(--ease-out);
}
.hero-card:hover{transform:rotateY(0) rotateX(0) scale(1.02)}
@keyframes float3d{
    0%,100%{transform:rotateY(-12deg) rotateX(6deg) translateY(0)}
    50%{transform:rotateY(-12deg) rotateX(6deg) translateY(-14px)}
}
.card-glow{
    position:absolute;top:-1px;left:-1px;right:-1px;height:3px;
    background:var(--grad1);border-radius:99px 99px 0 0;
}
.hero-card-header{display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem}
.hero-avatar{
    width:52px;height:52px;border-radius:14px;
    background:var(--grad1);display:flex;align-items:center;justify-content:center;
    font-family:var(--font-display);font-size:1.2rem;font-weight:800;color:#fff;
    flex-shrink:0;
}
.hero-card-name{font-family:var(--font-display);font-size:1rem;font-weight:700}
.hero-card-role{font-size:.78rem;color:var(--muted)}
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1.5rem}
.stat-item{background:var(--bg3);border-radius:12px;padding:.75rem;border:1px solid var(--border)}
.stat-val{font-family:var(--font-display);font-size:1.4rem;font-weight:800}
.stat-val.c1{color:var(--indigo-l)}.stat-val.c2{color:var(--cyan)}.stat-val.c3{color:var(--pink-l)}.stat-val.c4{color:var(--amber-l)}
.stat-key{font-size:.68rem;color:var(--muted);margin-top:.1rem}
.card-chips{display:flex;flex-wrap:wrap;gap:.4rem}
.chip{
    font-size:.68rem;font-weight:500;
    padding:.25rem .65rem;border-radius:99px;
    background:rgba(99,102,241,.15);color:var(--indigo-l);
    border:1px solid rgba(99,102,241,.25);
}
.chip.pink{background:rgba(236,72,153,.12);color:var(--pink-l);border-color:rgba(236,72,153,.25)}
.chip.cyan{background:rgba(34,211,238,.1);color:var(--cyan-l);border-color:rgba(34,211,238,.2)}

/* ─── SKILLS ──────────────────────────────────────────────── */
#skills{background:var(--bg2)}
.skills-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:2rem}
.skill-category{
    background:var(--card);border:1px solid var(--border);border-radius:20px;
    padding:1.75rem;transition:border-color .3s,box-shadow .3s;
}
.skill-category:hover{
    border-color:var(--indigo);
    box-shadow:0 0 32px rgba(99,102,241,.12);
}
.skill-cat-title{
    font-family:var(--font-display);font-size:.9rem;font-weight:700;
    text-transform:uppercase;letter-spacing:.08em;color:var(--indigo-l);
    margin-bottom:1.25rem;display:flex;align-items:center;gap:.5rem;
}
.skill-bar-wrap{margin-bottom:1rem}
.skill-bar-label{display:flex;justify-content:space-between;margin-bottom:.4rem}
.skill-bar-name{font-size:.85rem;font-weight:500}
.skill-bar-pct{font-size:.8rem;color:var(--muted);font-family:var(--font-display)}
.skill-bar-track{height:6px;background:var(--bg3);border-radius:99px;overflow:hidden}
.skill-bar-fill{
    height:100%;width:0;border-radius:99px;
    transition:width 1.2s var(--ease-out);
}
.fill-1{background:linear-gradient(90deg,var(--indigo),var(--indigo-l))}
.fill-2{background:linear-gradient(90deg,var(--cyan-d),var(--cyan))}
.fill-3{background:linear-gradient(90deg,var(--pink-d),var(--pink-l))}
.fill-4{background:linear-gradient(90deg,var(--amber),var(--amber-l))}

.tech-chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:2rem}
.tech-chip{
    display:inline-flex;align-items:center;gap:.4rem;
    padding:.4rem .9rem;border-radius:10px;font-size:.82rem;font-weight:500;
    background:var(--card2);border:1px solid var(--border);
    color:var(--muted);transition:all .25s var(--ease-spring);
}
.tech-chip:hover{border-color:var(--cyan);color:var(--cyan-l);transform:translateY(-2px);box-shadow:0 4px 16px rgba(34,211,238,.15)}
.tech-chip .icon{font-size:1rem}

/* ─── EXPERIENCE TIMELINE ─────────────────────────────────── */
#experience{background:var(--bg)}
.timeline{position:relative;padding-left:2.5rem}
.timeline::before{
    content:'';position:absolute;left:.75rem;top:0;bottom:0;
    width:2px;background:linear-gradient(to bottom,var(--indigo),var(--pink),transparent);
}
.tl-item{
    position:relative;margin-bottom:2.5rem;
    opacity:0;transform:translateX(-20px);
    transition:opacity .6s var(--ease-out),transform .6s var(--ease-out);
}
.tl-item.reveal{opacity:1;transform:translateX(0)}
.tl-dot{
    position:absolute;left:-2.5rem;top:.5rem;
    width:18px;height:18px;border-radius:50%;
    background:var(--indigo);border:3px solid var(--bg);
    box-shadow:0 0 12px var(--indigo),0 0 0 4px rgba(99,102,241,.15);
    transition:transform .3s var(--ease-spring);
}
.tl-item:hover .tl-dot{transform:scale(1.3)}
.tl-card{
    background:var(--card);border:1px solid var(--border);border-radius:18px;padding:1.5rem;
    transition:border-color .3s,box-shadow .3s,transform .3s var(--ease-spring);
}
.tl-card:hover{
    border-color:rgba(99,102,241,.5);
    box-shadow:0 0 40px rgba(99,102,241,.15),inset 0 1px 0 rgba(255,255,255,.04);
    transform:translateX(4px);
}
.tl-header{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:.5rem;margin-bottom:.75rem}
.tl-role{font-family:var(--font-display);font-size:1.05rem;font-weight:700}
.tl-badge{
    font-size:.72rem;font-weight:600;padding:.25rem .7rem;border-radius:99px;
    background:rgba(34,211,238,.1);color:var(--cyan);border:1px solid rgba(34,211,238,.2);
    white-space:nowrap;
}
.tl-company{font-size:.88rem;color:var(--indigo-l);font-weight:500;margin-bottom:.75rem}
.tl-desc{font-size:.88rem;color:var(--muted);line-height:1.7}
.tl-desc li{margin-bottom:.35rem;padding-left:.25rem}
.tl-desc li::marker{color:var(--cyan)}

/* ─── PROJECTS ────────────────────────────────────────────── */
#projects{background:var(--bg2)}
.projects-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem}
.project-card{
    background:var(--card);border:1px solid var(--border);border-radius:20px;
    padding:1.75rem;position:relative;overflow:hidden;
    opacity:0;transform:translateY(24px);
    transition:opacity .6s var(--ease-out),transform .6s var(--ease-out),border-color .3s,box-shadow .3s;
}
.project-card.reveal{opacity:1;transform:translateY(0)}
.project-card::before{
    content:'';position:absolute;inset:0;
    background:linear-gradient(135deg,rgba(99,102,241,.12),transparent,rgba(236,72,153,.08));
    opacity:0;transition:opacity .4s;
}
.project-card:hover::before{opacity:1}
.project-card:hover{
    border-color:rgba(99,102,241,.4);
    box-shadow:0 16px 48px rgba(0,0,0,.4),0 0 0 1px rgba(99,102,241,.15);
    transform:translateY(-4px) !important;
}
.project-emoji{font-size:2.5rem;margin-bottom:1rem;display:block;line-height:1}
.project-title{font-family:var(--font-display);font-size:1.15rem;font-weight:700;margin-bottom:.6rem}
.project-desc{font-size:.87rem;color:var(--muted);line-height:1.7;margin-bottom:1.25rem}
.project-tags{display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:1.25rem}
.project-tag{
    font-size:.7rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;
    padding:.2rem .65rem;border-radius:6px;
}
.tag-indigo{background:rgba(99,102,241,.15);color:var(--indigo-l);border:1px solid rgba(99,102,241,.2)}
.tag-pink{background:rgba(236,72,153,.12);color:var(--pink-l);border:1px solid rgba(236,72,153,.2)}
.tag-cyan{background:rgba(34,211,238,.1);color:var(--cyan-l);border:1px solid rgba(34,211,238,.15)}
.tag-amber{background:rgba(245,158,11,.12);color:var(--amber-l);border:1px solid rgba(245,158,11,.2)}
.project-highlight{
    display:flex;align-items:center;gap:.5rem;
    font-size:.8rem;color:var(--amber-l);font-weight:500;
    padding:.5rem .75rem;background:rgba(245,158,11,.08);border-radius:8px;
    border:1px solid rgba(245,158,11,.15);
}

/* ─── EDUCATION ───────────────────────────────────────────── */
#education{background:var(--bg)}
.edu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;margin-bottom:3rem}
.edu-card{
    background:var(--card);border:1px solid var(--border);border-radius:20px;padding:1.75rem;
    position:relative;overflow:hidden;
    transition:border-color .3s,box-shadow .3s,transform .3s var(--ease-spring);
}
.edu-card::after{
    content:'';position:absolute;top:0;left:0;right:0;height:3px;
    background:var(--grad2);
}
.edu-card:hover{border-color:rgba(34,211,238,.3);box-shadow:0 0 40px rgba(34,211,238,.1);transform:translateY(-3px)}
.edu-icon{font-size:2rem;margin-bottom:1rem}
.edu-degree{font-family:var(--font-display);font-size:1rem;font-weight:700;margin-bottom:.35rem}
.edu-school{font-size:.85rem;color:var(--cyan);font-weight:500;margin-bottom:.25rem}
.edu-location{font-size:.8rem;color:var(--muted)}
.edu-badge{
    display:inline-block;margin-top:.75rem;
    font-size:.72rem;font-weight:600;padding:.25rem .75rem;border-radius:99px;
    background:rgba(99,102,241,.15);color:var(--indigo-l);border:1px solid rgba(99,102,241,.2);
}

.lang-section-title{
    font-family:var(--font-display);font-size:1.1rem;font-weight:700;margin-bottom:1rem;color:var(--text)
}
.lang-grid{display:flex;flex-wrap:wrap;gap:1rem}
.lang-badge{
    display:flex;align-items:center;gap:.6rem;
    background:var(--card);border:1px solid var(--border);border-radius:14px;
    padding:.75rem 1.25rem;transition:all .3s var(--ease-spring);
}
.lang-badge:hover{border-color:var(--pink);transform:translateY(-2px);box-shadow:0 4px 20px rgba(236,72,153,.15)}
.lang-dot{width:8px;height:8px;border-radius:50%;background:var(--grad3);flex-shrink:0}
.lang-name{font-weight:500;font-size:.88rem}
.lang-level{font-size:.75rem;color:var(--muted)}

/* ─── CONTACT ─────────────────────────────────────────────── */
#contact{background:var(--bg2)}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:start}
.contact-info{display:flex;flex-direction:column;gap:1rem}
.contact-card{
    background:var(--card);border:1px solid var(--border);border-radius:18px;padding:1.25rem;
    display:flex;align-items:center;gap:1rem;
    transition:all .3s var(--ease-spring);
}
.contact-card:hover{border-color:var(--indigo);transform:translateX(4px);box-shadow:0 4px 24px rgba(99,102,241,.15)}
.contact-icon{
    width:44px;height:44px;border-radius:12px;flex-shrink:0;
    display:flex;align-items:center;justify-content:center;font-size:1.2rem;
}
.ci-1{background:rgba(99,102,241,.15);color:var(--indigo-l)}
.ci-2{background:rgba(34,211,238,.1);color:var(--cyan)}
.ci-3{background:rgba(236,72,153,.12);color:var(--pink-l)}
.contact-detail-label{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.2rem}
.contact-detail-val{font-size:.9rem;font-weight:500}

.contact-cta{
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:1.5rem;text-align:center;
    background:var(--card);border:1px solid var(--border);border-radius:20px;padding:2.5rem;
}
.ripple-avatar{
    width:100px;height:100px;border-radius:50%;
    background:var(--grad1);display:flex;align-items:center;justify-content:center;
    font-family:var(--font-display);font-size:2.2rem;font-weight:800;color:#fff;
    position:relative;cursor:none;
}
.ripple-avatar::before,.ripple-avatar::after{
    content:'';position:absolute;inset:-10px;border-radius:50%;
    border:2px solid var(--indigo);opacity:0;
    animation:ripple 2.5s ease-out infinite;
}
.ripple-avatar::after{animation-delay:1.25s}
@keyframes ripple{
    0%{transform:scale(.8);opacity:.6}
    100%{transform:scale(1.5);opacity:0}
}
.contact-cta-text{font-size:1.1rem;font-weight:500;color:var(--muted);line-height:1.6;max-width:240px}
.contact-cta-text strong{color:var(--text);font-weight:600}

/* ─── FOOTER ──────────────────────────────────────────────── */
footer{
    position:relative;z-index:2;
    text-align:center;padding:2rem;
    border-top:1px solid var(--border);
    font-size:.82rem;color:var(--subtle);
}
footer span{color:var(--indigo-l);font-weight:500}

/* ─── SCROLL REVEAL (generic) ─────────────────────────────── */
.sr{opacity:0;transform:translateY(20px);transition:opacity .65s var(--ease-out),transform .65s var(--ease-out)}
.sr.reveal{opacity:1;transform:none}
.sr-d1{transition-delay:.1s}
.sr-d2{transition-delay:.2s}
.sr-d3{transition-delay:.3s}

/* ─── RESPONSIVE ──────────────────────────────────────────── */
@media(max-width:768px){
    .nav-links{display:none}
    .nav-burger{display:flex}
    #hero{flex-direction:column;padding-top:80px}
    .hero-right{width:100%;display:flex;justify-content:center}
    .hero-card{transform:none !important;animation:float-simple 6s ease-in-out infinite}
    @keyframes float-simple{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
    .contact-grid{grid-template-columns:1fr}
    .timeline{padding-left:1.75rem}
    .timeline::before{left:.5rem}
    .tl-dot{left:-1.75rem}
}
@media(max-width:480px){
    .stat-grid{grid-template-columns:1fr 1fr}
    .hero-ctas{flex-direction:column}
    .btn{justify-content:center}
}
</style>
